<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MauiCompatTests</RootNamespace>
  </PropertyGroup>
  <!-- Code that touches MAUI APIs whose shape differs between MAUI 10 and 11, plus the slow-reading
       throttle of the Android memory metrics — a plain console runner, no test framework:
       `dotnet run` prints PASS/FAIL per check and exits non-zero on any failure. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <Using Include="Microsoft.Maui.Controls" />
    <Compile Include="..\..\src\Immons.Tools.Maui.Inspector\Features\Cookbook\VisualStates.cs" />
    <Compile Include="..\..\src\Immons.Tools.Maui.Inspector\Features\Memory\Metrics\ThrottledProbe.cs" />
  </ItemGroup>
</Project>
