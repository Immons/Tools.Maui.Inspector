    <Compile Include="..\..\src\Immons.Tools.Maui.Inspector\InspectorActivation.cs" />
    <Compile Include="..\..\src\Immons.Tools.Maui.Inspector\Features\Activation\ActivationGate.cs" />
  </ItemGroup>
</Project>
