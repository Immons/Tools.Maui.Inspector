<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ActivationTests</RootNamespace>
  </PropertyGroup>
  <!-- Links the MAUI-free activation rules — a plain console runner, no test framework:
       `dotnet run` prints PASS/FAIL per check and exits non-zero on any failure. -->
