<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RemoteControlTests</RootNamespace>
  </PropertyGroup>
  <!-- Links the MAUI-free remote-control sources (selector parsing, text matching, gesture geometry) —
       a plain console runner, no test framework: `dotnet run` prints PASS/FAIL per check and exits
       non-zero on any failure. The on-device part is covered by tools/inspector-remote.sh smoke runs. -->
  <ItemGroup>
    <Compile Include="..\..\src\Immons.Tools.Maui.Inspector\Features\RemoteControl\ElementQuery.cs" />
    <Compile Include="..\..\src\Immons.Tools.Maui.Inspector\Features\RemoteControl\GesturePath.cs" />
  </ItemGroup>
</Project>
