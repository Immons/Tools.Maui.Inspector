<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleApp.LeakDemo.LeakyPage"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="24,20" Spacing="14">
        <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" TextColor="#512BD4" />
        <Label Text="This page and its view model subscribe to a static event and never unsubscribe. Go back, take a Memory snapshot in the inspector — both stay alive, with the page's handler still connected."
               FontSize="14" TextColor="#5B5470" />
        <Label x:Name="SubscribersLabel" FontSize="13" TextColor="#666666" />
        <Button Text="← Back" Clicked="OnBackClicked" HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentPage>
