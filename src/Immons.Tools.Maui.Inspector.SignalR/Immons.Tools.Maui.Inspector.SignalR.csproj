<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<RootNamespace>Immons.Tools.Maui.Inspector.SignalR</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<!-- NuGet package -->
		<IsPackable>true</IsPackable>
		<PackageId>Immons.Tools.Maui.Inspector.SignalR</PackageId>
		<Title>Immons.Tools.Maui.Inspector.SignalR</Title>
		<Description>SignalR traffic for Immons.Tools.Maui.Inspector: one line on the HubConnectionBuilder (WithMauiInspector("chat")) and the web panel's SignalR view shows every hub's connection state, reconnects and the messages in both directions with masked, size-capped arguments. Inert unless UseMauiInspector was called.</Description>
		<PackageTags>maui;dotnet-maui;inspector;devtools;signalr;websockets;realtime;debugging</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\nugets\</PackageOutputPath>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- A floor, not a pin: apps on a newer client keep theirs. -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Immons.Tools.Maui.Inspector\Immons.Tools.Maui.Inspector.csproj" />
	</ItemGroup>

</Project>
